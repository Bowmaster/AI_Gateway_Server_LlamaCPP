# Phase 1 internal deployment — copy to .env and fill in.
# Generate each secret with: openssl rand -hex 32
# NEVER commit the real .env (see .gitignore).

# --- Domain / DNS ---
DOMAIN_INTERNAL=lan.example.com         # split-horizon internal zone
ACME_EMAIL=you@example.com
# DNS-01 provider token (example: Cloudflare). Scope to the zone only.
CF_API_TOKEN=replace-with-scoped-dns-token

# --- Postgres ---
POSTGRES_USER=appsvc
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=litellm

# --- LiteLLM ---
LITELLM_MASTER_KEY=sk-replace-with-openssl-rand-hex-32
DATABASE_URL=postgresql://appsvc:replace-me@postgres:5432/litellm

# --- Engine upstreams (separate boxes on VLAN 30) ---
# OpenAI-compatible base URLs. For ollama use http://host:11434 and ollama_chat/ models.
ENGINE_GPU_BASE=http://10.30.0.11:8081/v1
ENGINE_CPU_BASE=http://10.30.0.12:8081/v1

# --- Authelia secrets (each: openssl rand -hex 32) ---
AUTHELIA_SESSION_SECRET=replace-me
AUTHELIA_STORAGE_ENCRYPTION_KEY=replace-me
AUTHELIA_JWT_SECRET=replace-me
AUTHELIA_REDIS_PASSWORD=replace-me
